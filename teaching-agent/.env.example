# ===========================================================
# 模型通道配置
# 复制本文件为 .env.local 后填入真实值（.env.local 不进版本库）
# ===========================================================

# 使用哪条通道：school = 学校内网（默认）；stepfun = 阶跃星辰；agnes = Agnes 公网接口
MODEL_PROVIDER=school

# CatBoost 智能配筋实验：仅服务端读取，指向同机 Python 推理服务。
BEAM_SERVICE_URL=http://127.0.0.1:8001

# 部署到域名子路径时在构建前设置；本地根路径运行留空。
NEXT_PUBLIC_BASE_PATH=

# 实时课堂（仅服务端读取）。不配置访问码时拒绝教师开课。
CLASSROOM_TEACHER_ACCESS_CODE=
# 生产必须为绝对路径、跨发布保留；开发留空使用 .data/classroom/classroom.sqlite。
CLASSROOM_DB_PATH=
# 仅 origin，不含 /teachdemo；生产填 https://edsionc.top。
# 开发填手机可访问的局域网 IP 和端口，例如 http://192.168.1.10:3000。
CLASSROOM_PUBLIC_ORIGIN=

# Agnes：官方 OpenAI 兼容接口，文字和读图默认共用 3.0 Flash。
# 官方文档：https://www.agnes-ai.com/doc/agnes-30-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_CHAT_MODEL=agnes-3.0-flash
AGNES_VISION_MODEL=agnes-3.0-flash

# -----------------------------------------------------------
# school 通道（学校内网，需能访问该地址）
# 对话模型需要支持图片（多模态）。学生上传的图片直接交给这个模型，不再单独做 OCR。
# -----------------------------------------------------------
SCHOOL_CHAT_BASE_URL=http://your-school-intranet-host/v1
SCHOOL_CHAT_API_KEY=
SCHOOL_CHAT_MODEL=deepseek-v4-flash

# 图片通道：填写可读图的模型名称；若上面的模型支持图片，可填相同名称。
# 地址和密钥留空时沿用 SCHOOL_CHAT_BASE_URL / SCHOOL_CHAT_API_KEY。
SCHOOL_VISION_BASE_URL=
SCHOOL_VISION_API_KEY=
SCHOOL_VISION_MODEL=

# -----------------------------------------------------------
# stepfun 通道（测试用，公网可访问，模型本身看图）
# -----------------------------------------------------------
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_API_KEY=
STEPFUN_CHAT_MODEL=step-3.5-flash
