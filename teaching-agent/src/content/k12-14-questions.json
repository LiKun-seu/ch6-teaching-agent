        "id": "D",
        "text": "2.4"
      }
    ],
    "answer": "C",
    "analysis": "$\\rho'=0$ 时 $\\theta=2.0$；$\\rho'=\\rho$ 时才取 1.6，中间按 $\\theta=2.0-0.4\\rho'/\\rho$ 线性内插。",
    "source": "k12-14.md",
    "confidence": "high",
    "verified": true
  },
  {
