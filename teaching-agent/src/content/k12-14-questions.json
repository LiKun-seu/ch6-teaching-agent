    "source": "k12-14.md",
    "confidence": "high",
    "verified": true
  },
  {
    "id": "Q-K13-01",
    "type": "choice",
    "prompt": "GB 50010-2002 中钢筋混凝土受弯构件短期刚度 $B_s$ 的计算公式为：",
    "options": [
      {
        "id": "A",
        "text": "$B_s=\\dfrac{E_sA_sh_0^2}{1.15\\psi+0.2+\\dfrac{6\\alpha_E\\rho}{1+3.5\\gamma_f'}}$"
      },
      {
        "id": "B",
        "text": "$B_s=0.85E_cI_0$"
      },
      {
        "id": "C",
        "text": "$B_s=\\dfrac{E_sA_sh_0^2}{1.15\\psi+0.2+6\\alpha_E\\rho_{te}}$"
      },
      {
        "id": "D",
        "text": "$B_s=E_cI_0\\left(1+\\dfrac{6\\alpha_E\\rho}{1+3.5\\gamma_f'}\\right)$"
      }
    ],
    "answer": "A",
    "analysis": "B 为预应力混凝土要求不出现裂缝构件的公式；C 错把 $\\rho$ 写成 $\\rho_{te}$ 且丢了受压翼缘项。",
    "source": "k12-14.md",
    "confidence": "high",
    "verified": true
  },
  {
    "id": "Q-K13-02",
    "type": "choice",
    "prompt": "单筋矩形截面梁（无受压钢筋）按 GB 50010-2002 计算长期挠度时，挠度增大系数 $\\theta$ 应取：",
    "options": [
      {
        "id": "A",
        "text": "1.6"
      },
      {
        "id": "B",
        "text": "1.75"
