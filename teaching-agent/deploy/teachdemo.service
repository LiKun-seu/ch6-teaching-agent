[Unit]
Description=CH6 Teaching Agent Demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teachdemo
Group=teachdemo
WorkingDirectory=/srv/teachdemo/current
EnvironmentFile=/etc/teachdemo/teachdemo.env
ExecStart=/opt/node-v24.19.0/bin/node /srv/teachdemo/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3327
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=teachdemo

[Install]
WantedBy=multi-user.target
